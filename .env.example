# OpenChat Environment Configuration
# Copy this file to .env and fill in the values for your deployment.

# --- Database ---
POSTGRES_DB=openchat
POSTGRES_USER=openchat
POSTGRES_PASSWORD=change_me_in_production

# --- Redis ---
REDIS_PASSWORD=change_me_in_production

# --- Application Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_byte_hex_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI Configuration ---
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=your_gemini_api_key_here

# --- Host Identity Verification (Authenticated Host Mode) ---
# Optional: PEM-encoded public key for verifying host-signed JWT identity tokens
HOST_IDENTITY_PUBLIC_KEY=
# Optional: JWKS URL for fetching public keys (used if HOST_IDENTITY_PUBLIC_KEY not set)
HOST_IDENTITY_JWKS_URL=
# Optional: Expected 'iss' claim in host-signed JWTs
HOST_IDENTITY_ISSUER=
# Optional: Expected 'aud' claim in host-signed JWTs (default: openchat-widget)
HOST_IDENTITY_AUDIENCE=openchat-widget

# --- CORS ---
# Comma-separated list of allowed origins for the frontend (e.g. https://app.example.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Environment ---
ENVIRONMENT=production